# Токен від @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Telegram ID власників через кому. Бот працює лише в групах, куди його додав власник.
# Свій ID можна дізнатися, написавши боту /start в особисті.
OWNER_IDS=
# Необов'язково: групи, у яких бот працює незалежно від того, хто його додав.
ALLOWED_CHAT_IDS=

PERSONA_NAME=Котлетик-добросусід
AUTHOR=Владислав «Котлета»
DB_PATH=/var/lib/dobrosusid-bot/dobrosusid.sqlite3
TIMEZONE=Europe/Kyiv

# Аналіз — коли в чаті затихло на DEBOUNCE_SECONDS, але не пізніше MAX_WAIT_SECONDS.
DEBOUNCE_SECONDS=20
MAX_WAIT_SECONDS=60
CONTEXT_MESSAGES=40
# Самовільні втручання: не частіше ніж раз на COOLDOWN_MINUTES і не більше MAX_INTERVENTIONS_PER_DAY на добу.
COOLDOWN_MINUTES=10
MAX_INTERVENTIONS_PER_DAY=15
# Запобіжник витрат: максимум викликів моделі на добу для всіх чатів.
MAX_LLM_CALLS_PER_DAY=1500
INTRO_REMINDERS=true
INTRO_REMINDER_INTERVAL_MINUTES=20
# Повторні нагадування представитися: до INTRO_REMINDER_MAX разів, не частіше ніж раз на INTRO_REMINDER_REPEAT_DAYS.
INTRO_REMINDER_REPEAT_DAYS=3
INTRO_REMINDER_MAX=3

# Новачок не може писати в чат, поки не представиться боту в особистих (потрібне право «Блокувати користувачів»).
GATE_NEW_MEMBERS=true
# Якщо новачок так і не представився, обмеження знімається само через стільки годин.
GATE_TIMEOUT_HOURS=24

# Ліміти на одну людину: звернення до бота в чаті та спроби знайомства в особистих.
ADDRESS_LIMIT_PER_10MIN=3
ADDRESS_LIMIT_PER_DAY=20
DM_LLM_LIMIT_PER_DAY=10
# Домени, які бот може згадувати у відповідях (через кому). Порожньо — жодних посилань, карток і телефонів.
ALLOWED_LINK_DOMAINS=

# Графік відключень: порожній канал вимикає функцію. Ім'я каналу без @ та URL.
OUTAGE_CHANNEL=
OUTAGE_QUEUE=2.2
OUTAGE_POLL_MINUTES=15
